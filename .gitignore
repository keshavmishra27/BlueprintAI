# ==============================================================================
# BlueprintAI .gitignore
# Only allow: frontend, demo, backend, idea_refiner, solara_app
# ==============================================================================

# Ignore all files and directories by default
/*
.*

# Keep .gitignore and core repo configuration files if needed
!.gitignore
!.git/

# ------------------------------------------------------------------------------
# Whitelisted Folders (keep only these 5 requested folders)
# ------------------------------------------------------------------------------
!frontend/
!demo/
!backend/
!idea_refiner/
!solara_app/

# ------------------------------------------------------------------------------
# Standard Build & Cache Artifacts inside Whitelisted Folders
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

node_modules/
dist/
build/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.env
.env.*
!.env.example
*.sqlite
*.sqlite3
*.db
*.log
*.out
.DS_Store
Thumbs.db