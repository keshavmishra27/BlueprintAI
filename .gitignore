# ==============================================================================
# BlueprintAI .gitignore
# ==============================================================================

# Ignore all files and directories by default
/*
.*

# Keep .gitignore, git, readme, dependencies, and CI workflows
!.gitignore
!.git/
!.github/
!requirements.txt
!pytest.ini
!README.md

# ------------------------------------------------------------------------------
# Whitelisted Application & Library Folders
# ------------------------------------------------------------------------------
!frontend/
!demo/
!backend/
!idea_refiner/
!solara_app/
!decision_engine/
!product/
!tests/

# ------------------------------------------------------------------------------
# Standard Build & Cache Artifacts inside Whitelisted Folders
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

node_modules/
dist/
build/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.env
.env.*
!.env.example
*.sqlite
*.sqlite3
*.db
*.log
*.out
.DS_Store
Thumbs.db

# Runtime Workspaces & Test Dumps
workspace/
product/workspace/